# Copy to supabase/.env (git-ignored) — used only by supabase/scripts/*.
# Dashboard → Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
# Server-side secret: bypasses RLS. Never commit it, never ship it to a browser or a mobile app.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: password given to the demo accounts (default demo1234).
DEMO_PASSWORD=demo1234
